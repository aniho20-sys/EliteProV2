rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Null-safe accessors — userDoc() returns null when the Firestore profile
    // doesn't exist yet (e.g. mid-registration race). Accessing .role/.trainerId
    // on null would throw in rules evaluation, causing the query to fail.
    function userRole() {
      let d = userDoc();
      return d != null ? d.role : null;
    }

    function userTrainerId() {
      let d = userDoc();
      return d != null ? d.trainerId : null;
    }

    function isTrainer() {
      return isAuth() && userRole() == 'trainer';
    }

    function isOperator() {
      return isAuth() && userRole() == 'operator';
    }

    // trainerId may be cleared (a client leaving, a trainer removing a client) but never
    // pointed at a coach from the browser. Connecting goes through the
    // connectWithInviteCode callable, which checks the code (P2,
    // reports/production-audit-2026-09-28.md). Otherwise anyone knowing a coach's uid —
    // every removed client does — could attach themselves and read that coach's profile,
    // bank details included, and whole schedule.
    function trainerIdOnlyCleared() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trainerId'])
        || request.resource.data.trainerId == null;
    }

    function isTrainerOf(clientId) {
      let cd = get(/databases/$(database)/documents/users/$(clientId)).data;
      return isAuth()
        && userRole() == 'trainer'
        && cd != null
        && cd.trainerId == request.auth.uid;
    }

    // ── Users ──
    // A user document holds an email address, so reading one is not harmless. This used to
    // be `allow read: if isAuth()`, which let any signed-in account list every user on the
    // platform and collect every address. Access is now limited to the three relationships
    // the app actually has: your own document, your own clients, and your own coach.
    //
    // The one lookup that does NOT fit that shape is resolving an invite code, which by
    // definition happens before any relationship exists (CLAUDE.md #34). Rules cannot see a
    // query's where-clauses, so "allow a list only when it filters by inviteCode" is not
    // expressible here — that lookup moved server-side to the resolveInviteCode callable,
    // which returns the coach's id and name and nothing else.
    //
    // Self-create own profile; self-update, or trainer updating their own client.
    match /users/{userId} {
      // Single-document reads.
      allow get: if isOwner(userId)
        || isTrainerOf(userId)
        || (isAuth() && userTrainerId() == userId);

      // Queries. Rules are not filters: a query is allowed only if its constraints
      // guarantee every document it could return satisfies this expression, so the two
      // listeners in AppContext (where id == uid, where trainerId == uid) pass and an
      // unconstrained read of the collection fails.
      allow list: if isAuth()
        && (resource.data.id == request.auth.uid
            || resource.data.trainerId == request.auth.uid);
      // Self-create own profile, OR trainer creating a managed ghost client.
      //
      // Self-create used to accept any document at all (P1,
      // reports/production-audit-2026-09-28.md): a new account could make itself an
      // 'operator' — the gym啦 role that writes studios and reads every trainer
      // application — or start life with totalSessions: 1000 or subscriptionTester: true.
      // It is now exactly what completeProfile() writes: the two roles RoleSelectPage
      // offers, and profile fields only. Credit, billing and gating fields are only ever
      // set by the client's trainer (update branch below) or by Cloud Functions. When
      // gym啦 returns, operators are created server-side, never by self-signup.
      allow create: if (isOwner(userId)
          && request.resource.data.id == userId
          && request.resource.data.role in ['trainer', 'client']
          && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'role', 'avatar',
               'joinDate', 'trainerId', 'goals', 'age', 'height', 'speciality'])
          // Both are issued server-side now (P2 + P3): connectWithInviteCode sets trainerId,
          // ensureInviteCode sets inviteCode. A self-chosen code is how one trainer copied
          // another's.
          && (!('trainerId' in request.resource.data) || request.resource.data.trainerId == null))
        || (isTrainer()
            && request.resource.data.role == 'client'
            && request.resource.data.trainerId == request.auth.uid);
      // Role is immutable after creation — prevents client→trainer privilege escalation.
      // Self-update is restricted to personal profile fields only — billing fields
      // (totalSessions, sessionOffset) are intentionally excluded to prevent clients
      // from granting themselves free sessions.
      // renewalRate/renewalRateNext/bankDetails are trainer-only meaningful (read via a
      // client's trainerId relationship); renewalPrompt3Shown/renewalPrompt1Shown are
      // client-only meaningful (own dashboard prompt state). Harmless either way if the
      // "wrong" role writes them since nothing reads them off the wrong doc.
      allow update: if isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name','email','avatar','fcmTokens','goals','notes',
                         'age','height','speciality','trainerId',
                         'renewalRate','renewalRateNext','bankDetails','currency',
                         'renewalPrompt3Shown','renewalPrompt1Shown',
                         'renewalPromptSnoozedUntil',
                         'businessName','intakeCompleted',
                         'language','subscriptionRate','timeZone',
                         'workingHours','badges'])
          // workingHours: a trainer's bookable hours (Profile). Was missing from this list
          // until 2026-09-29, so saving it failed. Two 'HH:MM' strings.
          && (!('workingHours' in request.resource.data)
              || (request.resource.data.workingHours is map
                  && request.resource.data.workingHours.keys().hasOnly(['start', 'end'])
                  && request.resource.data.workingHours.start is string
                  && request.resource.data.workingHours.end is string))
          // badges: milestone badges from the client's own workout log (badgeUtils.js).
          // Cosmetic and shown nowhere yet; missing from this list until 2026-09-29.
          // timeZone: the trainer's IANA zone, written by the app from the browser.
          // onScheduleCreditUpdate reads it off the TRAINER's doc to place a session's
          // wall-clock time (functions/zonedTime.js); on a client doc nothing reads it.
          // A trainer can only move the late-cancel line for their own clients, whose
          // credit they can already edit directly.
          && (!('timeZone' in request.resource.data)
              || (request.resource.data.timeZone is string
                  && request.resource.data.timeZone.size() > 0
                  && request.resource.data.timeZone.size() <= 64))
          // subscriptionRate: a trainer's per-session rate for monthly plans (Phase 3).
          // Harmless on a client doc — the server reads it only from the TRAINER's doc,
          // and prices every plan itself; the client never sends a price. Deliberately
          // NOT in this list: subscriptionTester, which lets a client see the sandbox
          // plan picker. Only the trainer may set it, via the isTrainerOf branch below —
          // a client granting themselves test access is exactly what it must not allow.
          // language: the UI language chosen on the Profile card. Value-checked here so a
          // bad write cannot park the client on a language the app does not have.
          && (!('language' in request.resource.data)
              || request.resource.data.language in ['en', 'zh-HK'])
          // inviteCode is not in the list above: only ensureInviteCode writes it (P3).
          && trainerIdOnlyCleared()
        // Trainer updating their own client's profile — the allowlisted fields below.
        // Session credit accounting itself (booking/cancel/complete) runs server-side via
        // Cloud Functions using the admin SDK, which bypasses these rules entirely — so no
        // client-side sessionOffset write path is needed even for a removed client.
        || isTrainerOf(userId)
            && request.resource.data.role == resource.data.role
            // Only the fields the app writes to a client as their coach (production audit
            // 2026-09-28, High-value 3 — a coach could change a client's email or name).
            // firestore-tests/trainerClientUpdate.rules.test.js lists each writer; a field
            // the app starts writing must be added here and there.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['totalSessions','sessionOffset',
                           'renewalPrompt3Shown','renewalPrompt1Shown','renewalPromptSnoozedUntil',
                           'renewalSnoozedUntil','churnSnoozedUntil',
                           'tags','subscriptionTester','badges','trainerId'])
            // A trainer may remove a client but not hand them to another coach — that
            // would give an account the trainer controls a way into that coach's data.
            && trainerIdOnlyCleared();
      allow delete: if isOwner(userId);
    }

    // ── Owner operations ──
    // OWNER_EMAIL is literal because rules cannot read secrets — it must
    // stay in sync with the constant of the same name in functions/ownerAuth.js.
    // Everything here is written server-side by the Admin SDK, which bypasses these rules.
    // email_verified: the token carries whatever address an account signed up with, proven
    // or not. Same condition as isOwnerToken in functions/ownerAuth.js.
    match /platformEvents/{eventId} {
      allow read: if isAuth() && request.auth.token.email == 'aniho20@gmail.com'
        && request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Error reports from the app, grouped per error (functions/clientErrors.js). Written
    // only by the reportClientError function; the owner reads them on her Profile. They
    // hold stack traces and user ids, so nobody else reads them.
    match /clientErrors/{errorId} {
      allow read: if isAuth() && request.auth.token.email == 'aniho20@gmail.com'
        && request.auth.token.email_verified == true;
      allow write: if false;
    }
    // The per-day caps on the above. Server-only.
    match /clientErrorBudget/{day} {
      allow read, write: if false;
    }

    // GoCardless webhook events already processed, by event id (functions/gcWebhooks.js).
    // Server-only.
    match /gcEvents/{eventId} {
      allow read, write: if false;
    }

    // Invite code reservations — one document per code, owned by exactly one trainer.
    // Written and read only by Cloud Functions (functions/inviteCodes.js).
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // The Trigger Email extension's queue. Contains the owner's address and message
    // bodies, and nothing in the app ever needs to read it from the client.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ── Credit Ledger ──
    // Append-only history of top-ups (qty + rate + date). Trainer creates entries for
    // their own clients; trainer and that client can both read. No update/delete —
    // corrections happen by adding a new entry, not editing history.
    match /creditLedger/{entryId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isTrainer()
        && request.resource.data.trainerId == request.auth.uid
        && isTrainerOf(request.resource.data.clientId);
      allow update: if false;
      allow delete: if false;
    }

    // ── Body Stats ──
    // Subcollection: bodyStats/{clientId}/entries/{entryId}
    // Only the client themselves or their trainer can read/write entries
    match /bodyStats/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow write: if isOwner(clientId) || isTrainerOf(clientId);
      allow delete: if isOwner(clientId);
      match /entries/{entryId} {
        allow read: if isOwner(clientId) || isTrainerOf(clientId);
        allow create: if isOwner(clientId) || isTrainerOf(clientId);
        allow update: if isOwner(clientId) || isTrainerOf(clientId);
        allow delete: if isOwner(clientId);
      }
    }

    // ── Workout Plans ──
    // Only the trainer who owns or the assigned client can read.
    match /workoutPlans/{planId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Workout Logs ──
    // Only the client or their trainer can read.
    match /workoutLogs/{logId} {
      allow read: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid);
      // trainerId must be null or the creating client's actual trainer — prevents a
      // client from tagging arbitrary strangers as trainerId to get their logs
      // pulled into that trainer's workoutLogs listener.
      allow create: if isAuth() && (
        (request.resource.data.clientId == request.auth.uid
          && (request.resource.data.trainerId == null
              || request.resource.data.trainerId == userTrainerId()))
        || (isTrainerOf(request.resource.data.clientId)
            && request.resource.data.trainerId == request.auth.uid)
      );
      // Client can update their own log; trainer can update logs they created (createdBy) or add trainerNotes.
      // clientId/trainerId/createdBy are immutable after creation — without this, a client
      // could reassign their own log's clientId to another user, polluting that user's
      // workout history, PRs and progression charts with attacker-controlled data.
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        (isTrainerOf(resource.data.clientId) && (
          resource.data.createdBy == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerNotes'])
        ))
      )
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // ── Schedule ──
    // Trainer or client involved can read; clients can also read trainer's full schedule
    // to check real availability (so they don't see already-booked slots when booking).
    match /schedule/{schedId} {
      // The coach and the session's own client. Other clients of the same coach used to be
      // able to read it too — for booking availability — which showed them who else trains
      // there and the coach's notes (production audit 2026-09-28, High-value 4). Clients now
      // get free/busy times from the getTrainerAvailability function instead.
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isAuth() && (
        // Trainer books for their own client only
        (request.resource.data.trainerId == request.auth.uid &&
         get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.trainerId == request.auth.uid) ||
        // Client books with their own trainer only — as a plain pending booking. The
        // credit fields are the server's: onScheduleBooked skips any doc that already says
        // deductedAtBooking, so a client writing it themselves booked for free (P5,
        // reports/production-audit-2026-09-28.md). isBlocked/lateCancellation likewise.
        (request.resource.data.clientId == request.auth.uid &&
         userTrainerId() == request.resource.data.trainerId &&
         request.resource.data.status == 'pending' &&
         !request.resource.data.keys().hasAny(['deductedAtBooking', 'bookedOnCredit',
                                               'isBlocked', 'lateCancellation'])) ||
        // Trainer blocks their own time (no client)
        (isTrainer() && request.resource.data.trainerId == request.auth.uid
         && request.resource.data.isBlocked == true
         && request.resource.data.clientId == '')
      );
      // trainerId and clientId are immutable. The trainer may change anything else.
      // A client may do exactly one thing: cancel their own upcoming session. They used
      // to be able to change any field, so moving a finished session into the future and
      // cancelling it in the same write refunded the credit (P4,
      // reports/production-audit-2026-09-28.md). lateCancellation is the flag the late
      // cancel confirmation sets; the credit logic decides by time, not by that flag.
      allow update: if isAuth()
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.clientId == resource.data.clientId
        && (
          resource.data.trainerId == request.auth.uid
          || (resource.data.clientId == request.auth.uid
              && resource.data.status in ['pending', 'confirmed']
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'lateCancellation']))
        );
      // Trainer only. A client deleting a session erased the record of it — nothing in the
      // app offers a client delete, cancelling is the client's path.
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Messages ──
    // Only sender and recipient can read their messages.
    match /messages/{msgId} {
      allow read: if isAuth() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'from', 'to', 'text', 'timestamp', 'read'])
        && request.resource.data.keys().hasOnly(['id', 'from', 'to', 'text', 'timestamp', 'read'])
        // Recipient must be a real coaching contact — sender's trainer or sender's client —
        // otherwise any authed user could message (and spam) arbitrary strangers
        && (isTrainerOf(request.resource.data.to) || userTrainerId() == request.resource.data.to);
      allow update: if isAuth() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Exercises ──
    // Trainer reads own; client reads trainer's + personal.
    // Any auth user can create: trainer with own ID, client with trainer's ID or own ID.
    match /exercises/{exId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        userTrainerId() == resource.data.trainerId
      );
      allow create: if isAuth() && (
        request.resource.data.trainerId == request.auth.uid ||
        (userTrainerId() != null && request.resource.data.trainerId == userTrainerId())
      );
      // trainerId is immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Exercise Overrides ──
    // Per-trainer video/instructions customization layered on top of the static seed
    // exercises (which have no backing Firestore doc — see CLAUDE.md). Trainer owns
    // read/write on their own overrides; their clients can only read, never write.
    match /exerciseOverrides/{overrideId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        userTrainerId() == resource.data.trainerId
      );
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId and exerciseId are immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.exerciseId == resource.data.exerciseId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Templates ──
    // Trainer-only: personal reusable plan blueprints.
    match /templates/{templateId} {
      allow read: if isTrainer() && resource.data.trainerId == request.auth.uid;
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isTrainer() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // ── Invoices ──
    // Trainer can fully manage their own invoices; client can read invoices addressed to them.
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isTrainer()
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // ── Intake Forms ──
    // Client writes own onboarding questionnaire; client and their trainer can read.
    match /intakeForms/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow create: if isOwner(clientId);
      allow update: if isOwner(clientId);
      allow delete: if false;
    }

    // ── Studios ──
    // Any authenticated user can read; only operator can write.
    match /studios/{id} {
      allow read: if isAuth();
      allow write: if isOperator();
    }

    // ── Studio Slots ──
    // Any authenticated user can read; operator can create/delete;
    // trainer can book an available slot (update status to 'booked').
    match /studioSlots/{id} {
      allow read: if isAuth();
      allow create, delete: if isOperator();
      allow update: if isOperator()
        // Trainer books an available slot: only status/trainerId/bookedAt may change
        || (isTrainer() && resource.data.status == 'available'
            && request.resource.data.trainerId == request.auth.uid
            && request.resource.data.status == 'booked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trainerId', 'bookedAt']))
        // Trainer cancels their own booked slot: only status/trainerId/bookedAt may change
        || (isTrainer() && resource.data.status == 'booked'
            && resource.data.trainerId == request.auth.uid
            && request.resource.data.status == 'available'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trainerId', 'bookedAt']));
    }

    // ── Trainer Applications ──
    // Trainer creates own application; trainer and operator can read;
    // operator can review (update status); trainer can update own pending application.
    match /trainerApplications/{appId} {
      allow create: if isAuth() && isTrainer() && request.auth.uid == appId;
      allow read: if isAuth() && (request.auth.uid == appId || isOperator());
      allow update: if isOperator()
        || (isAuth() && request.auth.uid == appId && resource.data.status == 'pending');
    }

    // ── Subscriptions (Phase 3 — GoCardless billing) ──
    // Trainer or their own client can read; all writes are Cloud Functions /
    // Admin SDK only (webhook handlers, scheduled pause/cancel jobs) — this is
    // money-moving state, never client-writable even by the owning trainer.
    // See reports/phase3-subscription-design.md.
    match /subscriptions/{subId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow write: if false;
    }

    // ── Payment Provider Connections (Phase 3) ──
    // Per-trainer OAuth connection metadata (provider, provider account id,
    // environment, status) — NOT the access token itself, which lives in
    // Secret Manager, never Firestore. Owning trainer can read own; write is
    // server-side only (the OAuth callback Cloud Function).
    //
    // Provider-neutral by design: `provider` says which processor this
    // connection is for. GoCardless cannot serve Hong Kong at all (it has no
    // HKD and no FPS scheme — see reports/payment-provider-research-2026-09-06.md),
    // so a second processor is a certainty, not a maybe.
    match /paymentConnections/{trainerId} {
      allow read: if isOwner(trainerId);
      allow write: if false;
    }

    // ── OAuth CSRF Nonces (Phase 3) ──
    // Short-lived (10min), single-use tokens binding an OAuth callback
    // request back to the trainer who actually initiated it. Not tied to one
    // processor — a second provider's connect flow reuses this same mechanism.
    // Never client-readable or writable — created and consumed entirely by
    // Cloud Functions (see functions/gcOAuthNonce.js). A client being able to
    // even read this collection would leak nonce values it has no business
    // seeing; being able to write it would defeat the whole point.
    match /oauthNonces/{nonce} {
      allow read, write: if false;
    }
  }
}
