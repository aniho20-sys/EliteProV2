rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTrainer() {
      return isAuth() && userDoc().role == 'trainer';
    }

    function isTrainerOf(clientId) {
      return isAuth()
        && userDoc().role == 'trainer'
        && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId == request.auth.uid;
    }

    // ── Users ──
    // Any authed user can read user list (needed for client/trainer lookup, invite codes)
    // Self-create own profile; self-update, or trainer updating their own client
    match /users/{userId} {
      allow read: if isAuth();
      // Self-create own profile, OR trainer creating a managed ghost client
      allow create: if isOwner(userId)
        || (isTrainer()
            && request.resource.data.role == 'client'
            && request.resource.data.trainerId == request.auth.uid);
      allow update: if isOwner(userId) || isTrainerOf(userId);
      allow delete: if isOwner(userId);
    }

    // ── Body Stats ──
    // Doc ID = clientId; only the client themselves or their trainer can read/write
    match /bodyStats/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow write: if isOwner(clientId) || isTrainerOf(clientId);
      allow delete: if isOwner(clientId);
    }

    // ── Workout Plans ──
    // Only the trainer who owns or the assigned client can read.
    match /workoutPlans/{planId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Workout Logs ──
    // Only the client or their trainer can read.
    match /workoutLogs/{logId} {
      allow read: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && resource.data.clientId == request.auth.uid;
      allow delete: if false;
    }

    // ── Schedule ──
    // Only the trainer or client involved can read.
    match /schedule/{schedId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isAuth() && (
        request.resource.data.trainerId == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    // ── Messages ──
    // Only sender and recipient can read their messages.
    match /messages/{msgId} {
      allow read: if isAuth() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Exercises ──
    // Trainer reads own; client reads their trainer's. Defaults served from static JS.
    match /exercises/{exId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || userDoc().trainerId == resource.data.trainerId);
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if isTrainer() && (
        !('trainerId' in resource.data) || resource.data.trainerId == request.auth.uid
      );
    }
  }
}
