rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTrainer() {
      return isAuth() && userDoc().role == 'trainer';
    }

    // Check if the authenticated user is the trainer of a given client
    function isTrainerOf(clientId) {
      return isAuth()
        && userDoc().role == 'trainer'
        && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId == request.auth.uid;
    }

    // ── Users ──
    // Anyone logged in can read (needed for contact lists, client lists)
    // Only the user themselves can create/update their own profile
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isTrainer();
      allow delete: if false;
    }

    // ── Body Stats ──
    // Doc ID = clientId; client or their trainer can read/write
    match /bodyStats/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow write: if isOwner(clientId) || isTrainerOf(clientId);
    }

    // ── Workout Plans ──
    // Trainers create/edit/delete; assigned clients can read
    match /workoutPlans/{planId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isTrainer();
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Workout Logs ──
    // Client writes own logs; trainer of that client can read
    match /workoutLogs/{logId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isTrainerOf(resource.data.clientId)
      );
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && resource.data.clientId == request.auth.uid;
      allow delete: if false;
    }

    // ── Schedule ──
    // Both trainer and client involved can read/update
    match /schedule/{schedId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Messages ──
    // Only sender/recipient can read; only sender can create; recipient can mark read
    match /messages/{msgId} {
      allow read: if isAuth() && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Exercises ──
    // Anyone logged in can read; trainers can manage
    match /exercises/{exId} {
      allow read: if isAuth();
      allow create: if isTrainer();
      allow update: if isTrainer();
      allow delete: if isTrainer();
    }
  }
}
