rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Null-safe accessors — userDoc() returns null when the Firestore profile
    // doesn't exist yet (e.g. mid-registration race). Accessing .role/.trainerId
    // on null would throw in rules evaluation, causing the query to fail.
    function userRole() {
      let d = userDoc();
      return d != null ? d.role : null;
    }

    function userTrainerId() {
      let d = userDoc();
      return d != null ? d.trainerId : null;
    }

    function isTrainer() {
      return isAuth() && userRole() == 'trainer';
    }

    function isOperator() {
      return isAuth() && userRole() == 'operator';
    }

    function isTrainerOf(clientId) {
      let cd = get(/databases/$(database)/documents/users/$(clientId)).data;
      return isAuth()
        && userRole() == 'trainer'
        && cd != null
        && cd.trainerId == request.auth.uid;
    }

    // ── Users ──
    // Any authed user can read user list (needed for client/trainer lookup, invite codes)
    // Self-create own profile; self-update, or trainer updating their own client
    match /users/{userId} {
      allow read: if isAuth();
      // Self-create own profile, OR trainer creating a managed ghost client
      allow create: if isOwner(userId)
        || (isTrainer()
            && request.resource.data.role == 'client'
            && request.resource.data.trainerId == request.auth.uid);
      // Role is immutable after creation — prevents client→trainer privilege escalation.
      // Self-update is restricted to personal profile fields only — billing fields
      // (totalSessions, sessionOffset) are intentionally excluded to prevent clients
      // from granting themselves free sessions.
      // renewalRate/renewalRateNext/bankDetails are trainer-only meaningful (read via a
      // client's trainerId relationship); renewalPrompt3Shown/renewalPrompt1Shown are
      // client-only meaningful (own dashboard prompt state). Harmless either way if the
      // "wrong" role writes them since nothing reads them off the wrong doc.
      allow update: if isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name','email','avatar','fcmTokens','goals','notes',
                         'age','height','speciality','trainerId','inviteCode',
                         'renewalRate','renewalRateNext','bankDetails',
                         'renewalPrompt3Shown','renewalPrompt1Shown'])
        // Trainer updating their own client's full profile (totalSessions, sessionOffset, etc.)
        // Session credit accounting itself (booking/cancel/complete) runs server-side via
        // Cloud Functions using the admin SDK, which bypasses these rules entirely — so no
        // client-side sessionOffset write path is needed even for a removed client.
        || isTrainerOf(userId)
            && request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId);
    }

    // ── Credit Ledger ──
    // Append-only history of top-ups (qty + rate + date). Trainer creates entries for
    // their own clients; trainer and that client can both read. No update/delete —
    // corrections happen by adding a new entry, not editing history.
    match /creditLedger/{entryId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isTrainer()
        && request.resource.data.trainerId == request.auth.uid
        && isTrainerOf(request.resource.data.clientId);
      allow update: if false;
      allow delete: if false;
    }

    // ── Body Stats ──
    // Subcollection: bodyStats/{clientId}/entries/{entryId}
    // Only the client themselves or their trainer can read/write entries
    match /bodyStats/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow write: if isOwner(clientId) || isTrainerOf(clientId);
      allow delete: if isOwner(clientId);
      match /entries/{entryId} {
        allow read: if isOwner(clientId) || isTrainerOf(clientId);
        allow create: if isOwner(clientId) || isTrainerOf(clientId);
        allow update: if isOwner(clientId) || isTrainerOf(clientId);
        allow delete: if isOwner(clientId);
      }
    }

    // ── Workout Plans ──
    // Only the trainer who owns or the assigned client can read.
    match /workoutPlans/{planId} {
      allow read: if isAuth() && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Workout Logs ──
    // Only the client or their trainer can read.
    match /workoutLogs/{logId} {
      allow read: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid);
      // trainerId must be null or the creating client's actual trainer — prevents a
      // client from tagging arbitrary strangers as trainerId to get their logs
      // pulled into that trainer's workoutLogs listener.
      allow create: if isAuth() && (
        (request.resource.data.clientId == request.auth.uid
          && (request.resource.data.trainerId == null
              || request.resource.data.trainerId == userTrainerId()))
        || (isTrainerOf(request.resource.data.clientId)
            && request.resource.data.trainerId == request.auth.uid)
      );
      // Client can update their own log; trainer can update logs they created (createdBy) or add trainerNotes.
      // clientId/trainerId/createdBy are immutable after creation — without this, a client
      // could reassign their own log's clientId to another user, polluting that user's
      // workout history, PRs and progression charts with attacker-controlled data.
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        (isTrainerOf(resource.data.clientId) && (
          resource.data.createdBy == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerNotes'])
        ))
      )
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // ── Schedule ──
    // Trainer or client involved can read; clients can also read trainer's full schedule
    // to check real availability (so they don't see already-booked slots when booking).
    match /schedule/{schedId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == userTrainerId()
      );
      allow create: if isAuth() && (
        // Trainer books for their own client only
        (request.resource.data.trainerId == request.auth.uid &&
         get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.trainerId == request.auth.uid) ||
        // Client books with their own trainer only
        (request.resource.data.clientId == request.auth.uid &&
         userTrainerId() == request.resource.data.trainerId) ||
        // Trainer blocks their own time (no client)
        (isTrainer() && request.resource.data.trainerId == request.auth.uid
         && request.resource.data.isBlocked == true
         && request.resource.data.clientId == '')
      );
      // trainerId and clientId are immutable — only status/notes/time/type may change
      allow update: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      )
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    // ── Messages ──
    // Only sender and recipient can read their messages.
    match /messages/{msgId} {
      allow read: if isAuth() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'from', 'to', 'text', 'timestamp', 'read'])
        && request.resource.data.keys().hasOnly(['id', 'from', 'to', 'text', 'timestamp', 'read'])
        // Recipient must be a real coaching contact — sender's trainer or sender's client —
        // otherwise any authed user could message (and spam) arbitrary strangers
        && (isTrainerOf(request.resource.data.to) || userTrainerId() == request.resource.data.to);
      allow update: if isAuth() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Exercises ──
    // Trainer reads own; client reads trainer's + personal.
    // Any auth user can create: trainer with own ID, client with trainer's ID or own ID.
    match /exercises/{exId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        userTrainerId() == resource.data.trainerId
      );
      allow create: if isAuth() && (
        request.resource.data.trainerId == request.auth.uid ||
        (userTrainerId() != null && request.resource.data.trainerId == userTrainerId())
      );
      // trainerId is immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Exercise Overrides ──
    // Per-trainer video/instructions customization layered on top of the static seed
    // exercises (which have no backing Firestore doc — see CLAUDE.md). Trainer owns
    // read/write on their own overrides; their clients can only read, never write.
    match /exerciseOverrides/{overrideId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        userTrainerId() == resource.data.trainerId
      );
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId and exerciseId are immutable after creation
      allow update: if isAuth() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.exerciseId == resource.data.exerciseId;
      allow delete: if isAuth() && resource.data.trainerId == request.auth.uid;
    }

    // ── Templates ──
    // Trainer-only: personal reusable plan blueprints.
    match /templates/{templateId} {
      allow read: if isTrainer() && resource.data.trainerId == request.auth.uid;
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isTrainer() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // ── Invoices ──
    // Trainer can fully manage their own invoices; client can read invoices addressed to them.
    match /invoices/{invoiceId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isTrainer() && request.resource.data.trainerId == request.auth.uid;
      // trainerId is immutable after creation
      allow update: if isTrainer()
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == resource.data.trainerId;
      allow delete: if isTrainer() && resource.data.trainerId == request.auth.uid;
    }

    // ── Intake Forms ──
    // Client writes own onboarding questionnaire; client and their trainer can read.
    match /intakeForms/{clientId} {
      allow read: if isOwner(clientId) || isTrainerOf(clientId);
      allow create: if isOwner(clientId);
      allow update: if isOwner(clientId);
      allow delete: if false;
    }

    // ── Studios ──
    // Any authenticated user can read; only operator can write.
    match /studios/{id} {
      allow read: if isAuth();
      allow write: if isOperator();
    }

    // ── Studio Slots ──
    // Any authenticated user can read; operator can create/delete;
    // trainer can book an available slot (update status to 'booked').
    match /studioSlots/{id} {
      allow read: if isAuth();
      allow create, delete: if isOperator();
      allow update: if isOperator()
        // Trainer books an available slot: only status/trainerId/bookedAt may change
        || (isTrainer() && resource.data.status == 'available'
            && request.resource.data.trainerId == request.auth.uid
            && request.resource.data.status == 'booked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trainerId', 'bookedAt']))
        // Trainer cancels their own booked slot: only status/trainerId/bookedAt may change
        || (isTrainer() && resource.data.status == 'booked'
            && resource.data.trainerId == request.auth.uid
            && request.resource.data.status == 'available'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trainerId', 'bookedAt']));
    }

    // ── Trainer Applications ──
    // Trainer creates own application; trainer and operator can read;
    // operator can review (update status); trainer can update own pending application.
    match /trainerApplications/{appId} {
      allow create: if isAuth() && isTrainer() && request.auth.uid == appId;
      allow read: if isAuth() && (request.auth.uid == appId || isOperator());
      allow update: if isOperator()
        || (isAuth() && request.auth.uid == appId && resource.data.status == 'pending');
    }

    // ── Subscriptions (Phase 3 — GoCardless billing) ──
    // Trainer or their own client can read; all writes are Cloud Functions /
    // Admin SDK only (webhook handlers, scheduled pause/cancel jobs) — this is
    // money-moving state, never client-writable even by the owning trainer.
    // See reports/phase3-subscription-design.md.
    match /subscriptions/{subId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow write: if false;
    }

    // ── GoCardless Connections (Phase 3) ──
    // Per-trainer OAuth connection metadata (organisation id, environment,
    // status) — NOT the access token itself, which lives in Secret Manager,
    // never Firestore. Owning trainer can read own; write is server-side only
    // (the OAuth callback Cloud Function).
    match /gcConnections/{trainerId} {
      allow read: if isOwner(trainerId);
      allow write: if false;
    }

    // ── GoCardless OAuth CSRF Nonces (Phase 3) ──
    // Short-lived (10min), single-use tokens binding a gcOAuthCallback
    // request back to the trainer who actually initiated it via gcOAuthStart.
    // Never client-readable or writable — created and consumed entirely by
    // Cloud Functions (see functions/gcOAuthNonce.js). A client being able to
    // even read this collection would leak nonce values it has no business
    // seeing; being able to write it would defeat the whole point.
    match /gcOAuthNonces/{nonce} {
      allow read, write: if false;
    }
  }
}
